<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AppDetailActivity"
            android:exported="false" />

        <!-- 网页分身：8 个槽位各一个独立进程，各自一份 WebView 数据目录 -->
        <activity android:name=".BrowserP1" android:exported="true" android:process=":webp1" android:configChanges="orientation|screenSize|keyboardHidden" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".BrowserP2" android:exported="true" android:process=":webp2" android:configChanges="orientation|screenSize|keyboardHidden" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".BrowserP3" android:exported="true" android:process=":webp3" android:configChanges="orientation|screenSize|keyboardHidden" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".BrowserP4" android:exported="true" android:process=":webp4" android:configChanges="orientation|screenSize|keyboardHidden" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".BrowserP5" android:exported="true" android:process=":webp5" android:configChanges="orientation|screenSize|keyboardHidden" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".BrowserP6" android:exported="true" android:process=":webp6" android:configChanges="orientation|screenSize|keyboardHidden" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".BrowserP7" android:exported="true" android:process=":webp7" android:configChanges="orientation|screenSize|keyboardHidden" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".BrowserP8" android:exported="true" android:process=":webp8" android:configChanges="orientation|screenSize|keyboardHidden" android:windowSoftInputMode="adjustResize" />

        <provider
            android:name=".CloneFileProvider"
            android:authorities="com.suanran.ruyi.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true" />

    </application>
</manifest>
